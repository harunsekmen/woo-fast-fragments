{
  "name": "harunsekmen/woo-fast-fragments",
  "description": "High-performance client-side cart fragment caching and REST turbo layer for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Harun Sekmen",
      "homepage": "https://github.com/harunsekmen"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "WooFastFragments\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

